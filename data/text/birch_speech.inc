gText_Birch_Welcome::
	.string "...\p"
	.string "I am Deoxys.\p"
	.string "I have long traced the patterns\n"
	.string "of life and change.\p"
	.string "$"

gText_Birch_MainSpeech::
	.string "It was restored to life\n"
	.string "by unnatural means,\p"
	.string "yet it lives and breathes like\n"
	.string "you and I.\p"
	.string "DNA holds unfathomable power.\p"
	.string "I sense potential in you to\n"
	.string "harness this power.\p"
	.string "You will build an island sanctuary.\n"
	.string "Raise bloodlines. Endure and thrive.\p"
	.string "This island will test you.\n"
	.string "The lands beyond are unforgiving.\p"
	.string "$"

gText_Birch_AndYouAre::
	.string "But first, tell me about\n"
	.string "yourself.\p"
	.string "$"

gText_Birch_BoyOrGirl::
	.string "Are you a boy?\n"
	.string "Or are you a girl?$"

gText_Birch_WhatsYourName::
	.string "And what is your name?$"

gText_Birch_SoItsPlayer::
	.string "{PLAYER}{KUN}... is that right?\p"
	.string "$"

gText_Birch_YourePlayer::
	.string "Very well.\p"
	.string "$"

gText_Birch_AreYouReady::
	.string "The island awaits its guardian.\p"
	.string "Your choices will shape the fate\n"
	.string "of all who call it home.\p"
	.string "Raise your POKéMON well. Let\n"
	.string "their bloodlines endure.\p"
	.string "Now go, {PLAYER}{KUN}.\n"
	.string "Your journey begins.\p"
	.string "$"

gText_Helix_QuizIntro::
	.string "Now, {PLAYER}{KUN}, let me learn\n"
	.string "more about you.\p"
	.string "Answer honestly... your nature\n"
	.string "will determine your path.\p"
	.string "$"

gText_Helix_QuizQ1::
	.string "What calls to you most\n"
	.string "strongly?$"

gText_Helix_QuizQ1_Choice0::
	.string "The Land$"

gText_Helix_QuizQ1_Choice1::
	.string "The Sea$"

gText_Helix_QuizQ1_Choice2::
	.string "The Sky$"

gText_Helix_QuizQ2::
	.string "Which is the most\n"
	.string "powerful trait?$"

gText_Helix_QuizQ2_Choice0::
	.string "Knowledge$"

gText_Helix_QuizQ2_Choice1::
	.string "Emotion$"

gText_Helix_QuizQ2_Choice2::
	.string "Willpower$"

gText_Helix_QuizQ3::
	.string "What guides your\n"
	.string "path?$"

gText_Helix_QuizQ3_Choice0::
	.string "Truth$"

gText_Helix_QuizQ3_Choice1::
	.string "Ideals$"

gText_Helix_QuizQ3_Choice2::
	.string "Balance$"

gText_Helix_TypeResult::
	.string "I see it now...\p"
	.string "Your soul resonates with the\n"
	.string "{STR_VAR_1} type.\p"
	.string "The island has drawn POKéMON\n"
	.string "of this type to you.\p"
	.string "$"

gText_Helix_StarterIntro::
	.string "Three POKéMON species await you.\n"
	.string "Decide who will begin the bloodline.\p"
	.string "Choose your first ancestor.$"

gText_Helix_StarterSecond::
	.string "{PLAYER}{KUN} received {STR_VAR_1}!\p"
	.string "Now choose another\n"
	.string "ancestor.$"

gText_Helix_GotStarters::
	.string "{PLAYER}{KUN} received {STR_VAR_1}!\p"
	.string "$"
